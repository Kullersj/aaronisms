{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"],
      "env": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "passThroughEnv": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "MAILPIT_URL",
        "EMAIL_SMTP_URL"
      ],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["@aaronisms/web#build"],
      "cache": false,
      "passThroughEnv": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SITE_URL",
        "MODERATOR_EMAILS",
        "TURNSTILE_SECRET_KEY",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "EMAIL_TRANSPORT",
        "EMAIL_FROM",
        "MAILPIT_URL",
        "BASE_URL",
        "CI",
        "PW_CHROMIUM_PATH",
        "PLAYWRIGHT_BROWSERS_PATH",
        "EMAIL_SMTP_URL"
      ]
    }
  }
}

# Supabase (local: `supabase status -o env` in packages/db gives API_URL, ANON_KEY, SERVICE_ROLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site: used in emailed moderation links and the admin sign-in redirect.
SITE_URL=http://localhost:3000

# Comma-separated; every address gets each moderation email. The first is the default moderator:
# the Reply-To and the recipient of operational alerts. Every address can sign in to /admin.
MODERATOR_EMAILS=

# Cloudflare Turnstile. These are Cloudflare's documented test keys, which always pass; the secret
# is recognised and not sent to Cloudflare, so local development and CI work offline.
# Use real keys in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Email: `resend` sends through Resend (production); `smtp` sends real SMTP to EMAIL_SMTP_URL, which
# defaults to the local Supabase stack's Mailpit (read the messages at http://127.0.0.1:54324).
EMAIL_TRANSPORT=resend
EMAIL_FROM="Aaronisms <noreply@mail.example.com>"
RESEND_API_KEY=
EMAIL_SMTP_URL=smtp://127.0.0.1:54325

# Optional: one-off scripts (scripts/) fall back to NEXT_PUBLIC_SUPABASE_URL when this is unset.
SUPABASE_URL=


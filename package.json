{
  "name": "aaronisms",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "db:types": "pnpm --filter @aaronisms/db db:types",
    "prepare": "husky || true"
  },
  "prettier": "@aaronisms/config/prettier",
  "devDependencies": {
    "@aaronisms/config": "workspace:*",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "catalog:",
    "turbo": "^2.11.9"
  }
}
